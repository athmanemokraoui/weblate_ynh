#!/bin/bash

source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

#=================================================
# RESTORE THE APP MAIN DIR (excluding venv)
#=================================================
ynh_script_progression "Restoring the app main directory..."

# Restore user data, settings, and config files — NOT the venv itself.
# The venv is recreated below from the saved pip freeze (or fresh install if missing).
# This saves ~1GB on every backup archive.
ynh_restore "$install_dir/data"
ynh_restore "$install_dir/settings.py"
ynh_restore "$install_dir/local_settings.py"
ynh_restore "$install_dir/celery-weblate"
ynh_restore "$install_dir/gunicorn.env" 2>/dev/null || true
ynh_restore "$install_dir/venv_requirements.txt" 2>/dev/null || true
# Restore hub config if it was backed up
if [ -f "$install_dir/.config/hub" ]; then
    :
fi
ynh_restore "$install_dir/.config" 2>/dev/null || true
ynh_restore "$install_dir/.bashrc" 2>/dev/null || true

chmod 750 "$install_dir"
chmod -R o-rwx "$install_dir"
chown -R "$app:" "$install_dir"
chown "$app:www-data" "$install_dir"
chown -R "$app:www-data" "$install_dir/data"

#=================================================
# RECREATE THE VENV
#=================================================
ynh_script_progression "Recreating the Python virtual environment..."

borg_openssl_prefix="$(get_openssl_libdir)"

ynh_exec_as_app python3 -m venv "$install_dir/venv"
ynh_hide_warnings ynh_exec_as_app "$install_dir/venv/bin/pip" install --no-cache-dir --upgrade pip setuptools wheel pkgconfig gunicorn

if [ -f "$install_dir/venv_requirements.txt" ]; then
    # Fast path: restore from saved pip freeze (~30 seconds)
    ynh_print_info "Recreating venv from saved package list..."
    ynh_hide_warnings ynh_exec_as_app "$install_dir/venv/bin/pip" install --no-cache-dir -r "$install_dir/venv_requirements.txt"
else
    # Slow path: fresh install (no saved requirements — e.g. backup from older version)
    ynh_print_info "Saved package list not found — performing full pip install..."
    ynh_hide_warnings ynh_exec_as_app "$install_dir/venv/bin/pip" install --no-cache-dir --upgrade django-otp==1.6.3
    ynh_hide_warnings ynh_exec_as_app "$install_dir/venv/bin/pip" install --no-cache-dir --upgrade pip PyGObject==3.50.0
    ynh_hide_warnings ynh_exec_as_app "$install_dir/venv/bin/pip" install --no-cache-dir --force-reinstall --no-binary :all: cffi
    ynh_hide_warnings ynh_exec_as_app BORG_OPENSSL_PREFIX="$borg_openssl_prefix/" "$install_dir/venv/bin/pip" install --no-cache-dir Weblate=="$(ynh_app_upstream_version)"
    ynh_hide_warnings ynh_exec_as_app "$install_dir/venv/bin/pip" install --no-cache-dir psycopg2-binary ruamel.yaml aeidon phply boto3 google openai
    ynh_hide_warnings ynh_exec_as_app "$install_dir/venv/bin/pip" install --no-cache-dir django_sendmail_backend
fi

# Link settings.py into the venv so Weblate can find it
ln -sf "$install_dir/settings.py" "$install_dir/venv/lib/$weblate_pypath/site-packages/weblate/settings.py"
touch "$install_dir/local_settings.py"
ln -sf "$install_dir/local_settings.py" "$install_dir/venv/lib/$weblate_pypath/site-packages/weblate/local_settings.py"

# Regenerate gunicorn env if missing (in case CPU count changed since backup)
if [ ! -f "$install_dir/gunicorn.env" ]; then
    generate_gunicorn_env
fi

#=================================================
# RESTORE THE NGINX CONFIGURATION
#=================================================
ynh_script_progression "Restoring the NGINX web server configuration..."

ynh_restore "/etc/nginx/conf.d/$domain.d/$app.conf"

#=================================================
# RESTORE THE POSTGRESQL DATABASE
#=================================================
ynh_script_progression "Restoring the PostgreSQL database..."

ynh_psql_db_shell < ./db.sql

# Re-create the pg_trgm extension in case the restored DB didn't capture it
# (Weblate uses trigram indexes and migrations will fail without it).
ynh_psql_db_shell <<< "CREATE EXTENSION IF NOT EXISTS pg_trgm;"

#=================================================
# RESTORE SYSTEMD
#=================================================
ynh_script_progression "Restoring $app's systemd service..."

ynh_restore "/etc/systemd/system/$app.service"
systemctl enable "$app.service" --quiet

ynh_restore "/etc/systemd/system/$app.socket"
systemctl enable "$app.socket" --quiet

ynh_restore  "/etc/systemd/system/$app-celery.service"
systemctl enable "$app-celery" --quiet

#=================================================
# RESTORE THE LOGROTATE CONFIGURATION
#=================================================
ynh_script_progression "Restoring the logrotate configuration..."

mkdir -p "/var/log/$app"
ynh_restore "/etc/logrotate.d/$app"

#=================================================
# INTEGRATE SERVICE IN YUNOHOST
#=================================================
ynh_script_progression "Integrating service in YunoHost..."

yunohost service add "$app" --log="/var/log/$app/weblate.log"
yunohost service add "$app-celery" --log="/var/log/$app/weblate-celery-w1.log"

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

# Start the socket first — the gunicorn service declares `Requires=$app.socket`
# and binds to /run/$app.sock. Without an active socket, the service start fails.
ynh_systemctl --service="$app.socket" --action="start"
ynh_systemctl --service="$app" --action="start" --log_path="/var/log/$app/weblate.log" # --wait_until="spawned uWSGI"
ynh_systemctl --service="$app-celery" --action="start" --log_path="/var/log/$app/weblate-celery.log"

#=================================================
# RELOAD NGINX
#=================================================
ynh_script_progression "Reloading NGINX web server..."

ynh_systemctl --service=nginx --action=reload

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Restoration completed for $app"
